{
  "name": "@kesher/desktop",
  "version": "0.5.12",
  "private": true,
  "description": "Electron shell: starts the core server in-process and shows the web UI in a window.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && cross-env KESHER_DEV_URL=http://localhost:5173 electron .",
    "start": "electron .",
    "dist": "pnpm build && electron-builder"
  },
  "dependencies": {
    "@kesher/core": "workspace:*",
    "@kesher/shared": "workspace:*"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "dev.kesherai.app",
    "productName": "KesherAI",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../plugins",
        "to": "plugins",
        "filter": [
          "*/kesher-plugin.json",
          "*/dist/**",
          "*/ui/**",
          "*/README.md"
        ]
      },
      {
        "from": "../browser-extension",
        "to": "browser-extension"
      },
      {
        "from": "../../integrations/unity/com.kesherai.bridge",
        "to": "unity-package/com.kesherai.bridge"
      },
      {
        "from": "../../integrations/unreal/KesherAIBridge",
        "to": "unreal-plugin/KesherAIBridge",
        "filter": ["**/*", "!Binaries/**", "!Intermediate/**"]
      },
      {
        "from": "resources/mcp-bridge.cjs",
        "to": "mcp-bridge.cjs"
      },
      {
        "from": "../../packages/core/dist/cli.js",
        "to": "kesher-cli.mjs"
      },
      {
        "from": "resources/kesher.cmd",
        "to": "kesher.cmd"
      },
      {
        "from": "resources/kesher",
        "to": "kesher"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "KesherAI contributors <https://github.com/Deadchu-R/KesherAI/issues>",
      "executableName": "kesherai",
      "artifactName": "KesherAI-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Deadchu-R",
        "repo": "KesherAI",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Deadchu-R/KesherAI.git"
  },
  "author": {
    "name": "KesherAI contributors",
    "url": "https://github.com/Deadchu-R/KesherAI"
  }
}
