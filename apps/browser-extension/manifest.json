{
  "manifest_version": 3,
  "name": "KesherAI",
  "version": "0.2.6",
  "description": "Your local AI beside every page: chat with it, ask about the page, and let it do browser tasks you approve.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "sidePanel",
    "activeTab"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "page.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "KesherAI",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+K"
      }
    }
  },
  "sidebar_action": {
    "default_panel": "panel.html",
    "default_title": "KesherAI",
    "default_icon": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kesherai@kesherai.app",
      "strict_min_version": "128.0"
    }
  }
}
