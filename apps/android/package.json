{
  "name": "@kesher/android",
  "version": "0.4.33",
  "private": true,
  "description": "Android app: connects to KesherAI running on your computer. Built into an APK by GitHub Actions (.github/workflows/android.yml).",
  "license": "Apache-2.0",
  "scripts": {
    "add": "cap add android",
    "sync": "cap sync android",
    "apk": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@fontsource/rubik": "^5.3.0",
    "@wllama/wllama": "3.8.1",
    "capacitor-kesher-background": "file:./plugins/background",
    "capacitor-kesher-google": "file:./plugins/google",
    "capacitor-kesher-llm": "file:./plugins/llm",
    "capacitor-kesher-screen": "file:./plugins/screen",
    "capacitor-kesher-speech": "file:./plugins/speech",
    "capacitor-kesher-updater": "file:./plugins/updater",
    "capacitor-kesher-wake-on-lan": "file:./plugins/wake-on-lan"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0"
  }
}
