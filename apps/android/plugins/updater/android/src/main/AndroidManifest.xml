<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the app hand a downloaded update to the Android installer. The user still confirms it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application>
        <provider
            android:name="dev.kesherai.updater.UpdateFileProvider"
            android:authorities="${applicationId}.kesher.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/kesher_update_paths" />
        </provider>
    </application>
</manifest>
