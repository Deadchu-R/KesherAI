<?xml version="1.0" encoding="utf-8"?>
<!-- KesherAI on the home screen: ask (opens a new chat), speak, what runs on the computer, phone/PC health. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/kesher_widget_bg">

    <TextView
        android:id="@+id/kw_ask"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/kesher_widget_pill"
        android:textColor="#E8ECF4"
        android:textSize="16sp"
        android:text="@string/kesher_widget_ask" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/kw_voice" style="@style/KesherWidgetButton" android:text="@string/kesher_widget_voice" />
        <TextView android:id="@+id/kw_tasks" style="@style/KesherWidgetButton" android:layout_marginStart="8dp" android:text="@string/kesher_widget_tasks" />
        <TextView android:id="@+id/kw_health" style="@style/KesherWidgetButton" android:layout_marginStart="8dp" android:text="@string/kesher_widget_health" />
    </LinearLayout>
</LinearLayout>
