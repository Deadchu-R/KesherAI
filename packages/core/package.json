{
  "name": "@kesher/core",
  "version": "0.5.9",
  "description": "The local KesherAI server: model registry, chat and image routes, downloads, plugins, skills, remote access and an OpenAI-compatible API.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kesher-core": "./dist/main.js",
    "kesher": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=source src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/compress": "9.3.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/http-proxy": "11.6.6",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@kesher/agent": "workspace:*",
    "@kesher/downloads": "workspace:*",
    "@kesher/plugin-sdk": "workspace:*",
    "@kesher/providers": "workspace:*",
    "@kesher/shared": "workspace:*",
    "@kesher/skills": "workspace:*",
    "@lydell/node-pty": "1.2.0-beta.18",
    "fastify": "^5.2.0",
    "fflate": "^0.8.3",
    "tesseract.js": "^6.0.1",
    "ws": "8.22.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}
