     "maxRamPercent": 85,
     "maxCpuPercent": 80,
     "maxCpuTemp": 0
    },
    "cards": [
     {
      "index": 0,
      "name": "NVIDIA GeForce RTX 3090",
      "temp": 46,
      "util": 3,
      "memUsed": 1932735283.2,
      "memTotal": 25769803776,
      "power": 38,
      "powerLimit": 350
     }
    ],
    "paused": false,
    "cooling": false,
    "system": {
     "ramUsed": 22548578304,
     "ramTotal": 99857989632,
