    },
    "model": {
     "name": "TranslateGemma 4B",
     "sizeGb": 2.5,
     "downloaded": false
    },
    "max": 20000
   }
  },
  {
   "url": "**/api/translate",
   "method": "POST",
   "json": {
    "text": "A small brown monkey sitting on a palm tree at sunset, watercolor style",
    "via": "gemini",
    "model": "gemini/gemini-2.5-flash",
    "to": "en"
   }
  }
 ],
 "boards": [
  {
   "id": "LoadOnDemand",
   "title": "הגדרות: טעינה לפי צורך (זמן פריקה לכל מנוע, להשאיר טעון)",
   "route": "#/settings/computer",
   "fullPage": false,
   "height": {
    "desktop": 900,
    "phone": 1600
   },
   "steps": [
    {
     "wait": ".guard-on-demand"
    },
    {
     "scroll": ".guard-on-demand"
    }
   ]
  },
  {
   "id": "TranslatePage",
   "title": "תרגום: עברית ⇄ אנגלית, עם המודל הזול שזמין",
   "route": "#/translate",
   "fullPage": true,
   "height": {
    "desktop": 700,
    "phone": 1100
   },
   "steps": [
    {
     "wait": ".page.translate textarea"
    },
    {
     "fill": ".page.translate textarea",
     "value": "קוף חום קטן יושב על עץ דקל בשקיעה, בסגנון צבעי מים"
    },
    {
     "click": ".page.translate button.primary"
    },
    {
     "wait": ".page.translate textarea[readonly]"
    }
   ]
  }
 ]
}