  {
   "id": "ChatVideoSurface",
   "title": "וידאו בצ'אט: כרטיס עם פוסטר ואורך; בפאנל נגן, סימון תחילה וסוף, חיתוך, עורך מלא ושאלה על הקטע. בטלפון: צפייה ושאלה, \"עריכה\" כבויה",
   "titleEn": "Video in chat: card with poster and length; panel with player, in/out marks, trim, Full editor, ask about a range. Phone: watch and ask, Edit disabled",
   "route": "#/c/c9",
   "viewports": [
    "desktop",
    "phone"
   ],
   "height": {
    "desktop": 800,
    "phone": 844
   },
   "mocks": [
    {
     "url": "**/api/conversations/c9",
     "method": "GET",
     "json": {
      "id": "c9",
      "projectId": null,
      "title": "קליפ של שועל ביער",
      "kind": "chat",
      "modelId": "qwen3",
      "mode": "ask",
      "createdAt": {
       "$ago": "30m"
      },
      "updatedAt": {
       "$ago": "2m"
      },
      "messageCount": 4,
      "session": {
       "id": "c9",
       "status": "idle",
       "modelId": "qwen3",
       "mode": "ask",
       "pendingApprovals": [],
       "pendingQuestions": [],
       "canUndo": false,
       "grants": [],
       "queued": []
      },
      "events": [
       {
        "seq": 1,
        "at": {
         "$ago": "5m"
        },
        "type": "user",
        "text": "תכין לי קליפ קצר של שועל רץ ביער ותפתח אותו"
       },
       {
        "seq": 2,
        "at": {
         "$ago": "4m"
        },
        "type": "tool_call",
        "callId": "o1c",
        "name": "open_in_chat",
        "input": {
         "path": "shared/fox-run.mp4"
        }
       },
       {
        "seq": 3,
        "at": {
         "$ago": "4m"
        },
        "type": "tool_result",
        "callId": "o1c",
        "name": "open_in_chat",
        "ok": true,
        "output": "Opened in the chat: shared/fox-run.mp4\nThe user sees it in the side panel, in the installed tool for its type (or is offered to install that tool)."
       },
       {
        "seq": 4,
        "at": {
         "$ago": "3m"
        },
        "type": "assistant",
        "turn": 1,
        "text": "הקליפ מוכן ופתוח בצד. אפשר לסמן קטע בנגן ולשאול עליו, או לחתוך אותו."
       }
      ]
     }
    },
    {
