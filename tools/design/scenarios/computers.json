    {
      "id": "PcUpdatedCard",
      "title": "טלפון מחובר: כרטיס חד-פעמי \"המחשב עודכן ל-…\" עם מה חדש מכל הגרסאות מאז שהטלפון ראה, ושורה אם גם אפליקציית הטלפון מחכה לעדכון",
      "titleEn": "Phone connected: a one-time \"The PC was updated to …\" card with what is new in every version since the phone last saw one",
      "route": "#/",
      "viewports": [
        "phone",
        "desktop"
      ],
      "height": {
        "desktop": 700,
        "phone": 900
      },
      "steps": [
        {
          "local": {
            "key": "kesherai-seen-version",
