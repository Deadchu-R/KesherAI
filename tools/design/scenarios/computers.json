  "boards": [
    {
      "id": "PcUpdatedCard",
      "title": "טלפון מחובר: כרטיס חד-פעמי \"המחשב עודכן ל-…\" עם מה חדש מכל הגרסאות מאז שהטלפון ראה, ושורה אם גם אפליקציית הטלפון מחכה לעדכון",
      "titleEn": "Phone connected: a one-time \"The PC was updated to …\" card with what is new in every version since the phone last saw one",
      "route": "#/",
      "viewports": [
        "phone",
        "desktop"
      ],
      "height": {
        "desktop": 700,
        "phone": 900
      },
      "steps": [
        {
          "local": {
            "key": "kesherai-seen-version",
            "value": "0.6.439"
          }
        },
        {
          "wait": ".updated-card"
        }
      ]
    },
    {
      "id": "ComputersMenu",
      "title": "תפריט מחשבים אחד לכל האפליקציה: מחוברים וזמינים, נראה לאחרונה, גרסה, \"השתמש בכל הצ'אטים\", מעבר וניתוק",
      "titleEn": "One Computers menu for the whole app: state, last seen, version, use for all chats, switch and disconnect",
      "route": "#/",
      "viewports": [
        "phone",
        "desktop"
      ],
      "height": {
        "desktop": 900,
        "phone": 1000
      },
      "steps": [
        {
          "click": ".bar-status"
        },
        {
          "wait": ".pcs-row"
        }
      ]
    },
    {
      "id": "PhoneHealth",
      "title": "טלפון מחובר: מסך בריאות של המחשב (כרטיס המסך, המודל בזיכרון, מה תופס אותו, כפתור שחרר זיכרון) ובו גם בריאות הטלפון: סוללה, אחסון, רשת וגרסה",
      "titleEn": "Phone connected: a Health screen for the PC (graphics card, loaded model, what uses it, Free memory) and the phone's own: battery, storage, network, version",
      "route": "#/health",
      "viewports": [
        "phone"
      ],
      "height": {
        "phone": 1300
      },
      "steps": [
        {
          "local": {
            "key": "kesher-token",
            "value": "design"
          }
        },
        {
          "wait": ".health-score"
        }
      ]
    },
    {
      "id": "PhoneSettingsSplit",
      "title": "טלפון מחובר: כפתור הגדרות הטלפון בסרגל העליון, ובו \"הגדרות המחשב\" ו\"בריאות\" כקישורים נפרדים מהגדרות המכשיר (התראות, שפה, מראה, איזה מחשב)",
      "titleEn": "Phone connected: the Phone settings button in the top bar, with \"PC settings\" and Health kept apart from this device's own settings",
      "route": "#/",
      "viewports": [
        "phone"
      ],
      "height": {
        "phone": 1000
      },
      "steps": [
        {
          "local": {
            "key": "kesher-token",
            "value": "design"
          }
        },
        {
          "click": ".phone-settings-btn"
        },
