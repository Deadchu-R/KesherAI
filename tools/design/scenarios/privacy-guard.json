  {
   "id": "PrivacyModelPicker",
   "title": "בחירת מודל בצ'אט: תגית \"⚠ עשוי לאמן על המידע שלך\" ליד מודלים של שירותים שמאמנים (Gemini חינמי, Mistral, מודלי :free ב-OpenRouter), ו-⚠ קטן בצ'יפ של המודל",
   "titleEn": "Chat model menu: a \"⚠ may train on your data\" tag beside models whose service may train (free Gemini, Mistral, OpenRouter :free), and a small ⚠ on the model …",
   "route": "#/c/c1",
   "height": {
    "desktop": 900,
    "phone": 1500
   },
   "mocks": [
    {
     "url": "**/api/conversations/c1",
     "method": "GET",
     "json": {
      "id": "c1",
      "projectId": null,
      "title": "הסבר על ההתחברות",
      "kind": "chat",
      "modelId": "gemini/gemini-2.5-flash",
      "mode": "ask",
      "createdAt": {
       "$ago": "8m"
      },
      "updatedAt": {
       "$ago": "1m"
      },
      "messageCount": 2,
      "session": {
       "id": "c1",
       "status": "idle",
       "modelId": "gemini/gemini-2.5-flash",
       "mode": "ask",
       "pendingApprovals": [],
       "pendingQuestions": [],
       "canUndo": false,
       "grants": [],
       "queued": []
      },
      "events": [
       {
        "seq": 1,
        "at": {
         "$ago": "6m"
        },
        "type": "user",
        "text": "תסביר לי איך עובד ה-hook של ההתחברות"
       },
       {
        "seq": 2,
        "at": {
         "$ago": "6m"
        },
        "type": "assistant",
        "turn": 1,
        "text": "ה-hook שומר את הטוקן בזיכרון ומרענן אותו כשנשארות 5 דקות לתוקף."
       }
      ]
     }
    },
    {
     "url": "**/api/conversations/c1/helpers",
     "json": {
      "runs": [],
      "agents": []
     }
    },
    {
     "url": "**/api/conversations/c1/events*",
     "body": ": hi\n\n",
     "contentType": "text/event-stream"
    },
    {
     "url": "**/api/model-router",
     "method": "GET",
     "json": {
      "defaultAuto": false,
      "cloudKinds": [],
      "labels": {},
      "models": []
     }
    }
   ],
   "steps": [
    {
     "local": {
      "key": "kesher.trainWarned.c1.gemini",
      "value": "1"
     }
    },
    {
     "wait": ".model-chip .train-tag"
    },
    {
     "click": "button.model-chip:has(.train-tag)",
     "force": true
    },
    {
     "wait": ".model-pop"
    },
    {
     "waitMs": 500
    }
   ]
  },
